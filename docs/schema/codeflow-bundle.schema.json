{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "codeflow": {
      "type": "number",
      "const": 1
    },
    "org": {
      "type": "string"
    },
    "exported": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string",
                "pattern": "^[\\w.-]+\\/[\\w.-]+$"
              },
              "ado": {
                "type": "string",
                "pattern": "^[\\w.-]+$"
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "include": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "archived": {
                "type": "boolean"
              },
              "forks": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "since": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "github": {
          "default": {},
          "type": "object",
          "properties": {
            "api_url": {
              "default": "https://api.github.com",
              "type": "string",
              "format": "uri"
            },
            "token_env": {
              "default": "GITHUB_TOKEN",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "azure_devops": {
          "default": {},
          "type": "object",
          "properties": {
            "url": {
              "default": "https://dev.azure.com",
              "type": "string",
              "format": "uri"
            },
            "token_env": {
              "default": "AZURE_DEVOPS_TOKEN",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "data_dir": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "promotions": {
          "default": [
            "main",
            "master",
            "trunk",
            "develop",
            "development",
            "dev",
            "staging",
            "stage",
            "production",
            "prod",
            "release",
            "release/*",
            "releases/*"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bots": {
          "default": {},
          "type": "object",
          "properties": {
            "accounts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reviewers": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "include_prs": {
              "default": true,
              "type": "boolean"
            },
            "ignore_bodies": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "match": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "bucket": {
                "type": "string",
                "enum": [
                  "product",
                  "test",
                  "docs",
                  "generated",
                  "vendored",
                  "lockfile"
                ]
              },
              "repos": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "match",
              "bucket"
            ],
            "additionalProperties": false
          }
        },
        "sync_every": {
          "default": "24h",
          "type": "string",
          "pattern": "^(off|\\d+[mhd])$"
        },
        "stale_after_days": {
          "default": 90,
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "people_views": {
          "default": true,
          "type": "boolean"
        },
        "churn_window_days": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "size_target_lines": {
          "default": 400,
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "local_copies": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ticket_pattern": {
          "type": "string"
        },
        "duplicates_by_work_item": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "people": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "default": {},
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "github": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ado": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "internal": {
            "type": "boolean"
          },
          "bot": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "people": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "to": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "secondary": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "login"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "people"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "default": "group",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "repos": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "teams": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "people": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "repos": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "teams": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "people": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "scope": {
            "default": {},
            "type": "object",
            "properties": {
              "repos": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "teams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "people": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "when": {
            "default": {},
            "type": "object",
            "properties": {
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "title": {
                "type": "string"
              },
              "base": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "head": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "author_association": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "from_fork": {
                "type": "boolean"
              },
              "draft": {
                "type": "boolean"
              },
              "author_bot": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "then": {
            "type": "object",
            "properties": {
              "count": {
                "type": "boolean"
              },
              "internal": {
                "type": "boolean"
              },
              "ignore_comments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "measured_branches": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "promotion_branches": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "match": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      ]
                    },
                    "bucket": {
                      "type": "string",
                      "enum": [
                        "product",
                        "test",
                        "docs",
                        "generated",
                        "vendored",
                        "lockfile"
                      ]
                    }
                  },
                  "required": [
                    "match",
                    "bucket"
                  ],
                  "additionalProperties": false
                }
              },
              "bot": {
                "type": "boolean"
              },
              "bot_reviews_count": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "then"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "codeflow"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/danielhill13/Code-Flow/docs/schema/codeflow-bundle.schema.json",
  "title": "codeflow bundle",
  "description": "An org's people, groups and rules, as `codeflow export` writes and `codeflow import` reads."
}
