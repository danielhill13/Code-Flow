{
  "name": "codeflow",
  "version": "0.0.0",
  "private": true,
  "description": "Code flow metrics for GitHub: how pull requests move from first commit, through review, to merge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codeflow": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codeflow": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
