{
  "name": "codeflow",
  "version": "0.0.0",
  "private": true,
  "description": "Code flow metrics for GitHub: how pull requests move from first commit, through review, to merge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "codeflow": "dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codeflow": "node src/cli/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/report && tsc --noEmit -p src/report/tsconfig.test.json && tsc --noEmit -p test/e2e",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:scenarios": "vitest run --project scenarios",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright install chromium && npm run build:report && playwright test",
    "coverage": "vitest run --coverage",
    "build": "npm run build:cli && npm run build:report",
    "schema": "node scripts/schema.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run build && npm run test:e2e",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:report": "vite build --config vite.report.config.ts",
    "report:dev": "node src/cli/main.ts build --data-only && vite --config vite.report.config.ts"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "commander": "^15.0.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.5",
    "preact": "^11.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
